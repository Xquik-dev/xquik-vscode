#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik Contributors
# SPDX-License-Identifier: MIT

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly repository="Xquik-dev/xquik-vscode"
readonly status_context="xquik-local-checks"
readonly registry="https://open-vsx.org"
readonly token_item="xquik-open-vsx-token"
readonly editor_app="${XQUIK_EDITOR_APP:-/Applications/Cursor.app}"
readonly retry_seconds="${RELEASE_RETRY_SECONDS:-30}"
readonly retry_attempts="${RELEASE_RETRY_ATTEMPTS:-40}"

dry_run=false
for argument in "$@"; do
	case $argument in
		--dry-run) dry_run=true ;;
		*)
			printf 'Unknown option %s. Run bin/release-local or bin/release-local --dry-run.\n' "$argument" >&2
			exit 2
			;;
	esac
done

trap 'exit 130' INT TERM

step() {
	printf '%s\n' "$1"
}

stop() {
	printf 'Release stopped: %s\n' "$1" >&2
	exit 1
}

[[ -n "${XQUIK_EDITOR_KEYCHAIN_SERVICE:-}" ]] ||
	stop "set XQUIK_EDITOR_KEYCHAIN_SERVICE to the service of the Keychain item that holds the Xquik API key."

step "Checking that the working tree is clean."
[[ -z "$(git status --porcelain)" ]] || stop "commit or remove local changes first."

commit=$(git rev-parse HEAD)

if $dry_run; then
	step "This is a dry run, so the branch and its GitHub status are not checked."
else
	step "Checking that main is checked out."
	[[ "$(git symbolic-ref --quiet --short HEAD || true)" == "main" ]] || stop "switch to main first."

	step "Fetching main from origin."
	git fetch --quiet origin main

	step "Checking that main matches origin/main."
	[[ "$commit" == "$(git rev-parse origin/main)" ]] ||
		stop "pull or push until main matches origin/main."

	step "Checking GitHub CLI access."
	gh auth status --hostname github.com >/dev/null 2>&1 || stop "run gh auth login first."

	step "Checking the $status_context status of $commit."
	checks=$(gh api "repos/$repository/commits/$commit/status" \
		--jq "[.statuses[] | select(.context == \"$status_context\") | .state] | first // \"missing\"") ||
		stop "could not read commit statuses. Check gh auth status, then retry."
	[[ "$checks" == "success" ]] ||
		stop "the $status_context status is $checks. Run bin/check-local through the gate first."
fi

step "Reading the extension id and version from package.json."
publisher=$(node -p "require('./package.json').publisher")
name=$(node -p "require('./package.json').name")
version=$(node -p "require('./package.json').version")
extension="$publisher.$name@$version"
tag="v$version"
vsix="dist/$name-$version.vsix"
version_url="$registry/api/$publisher/$name/$version"

step "Checking that tag $tag is new or already on this commit."
local_tag=$(git rev-parse --quiet --verify "refs/tags/$tag^{commit}" || true)
[[ -z "$local_tag" || "$local_tag" == "$commit" ]] ||
	stop "tag $tag points at another commit. Bump the version in package.json first."
remote_tag_status=0
remote_tag=$(git ls-remote --exit-code origin "refs/tags/$tag^{}") || remote_tag_status=$?
case $remote_tag_status in
	0)
		[[ "${remote_tag%%[[:space:]]*}" == "$commit" ]] ||
			stop "tag $tag on origin points at another commit. Bump the version in package.json first."
		if [[ -z "$local_tag" ]]; then
			git fetch --quiet origin "refs/tags/$tag:refs/tags/$tag"
			local_tag=$commit
		fi
		;;
	2) ;;
	*) stop "could not read tags from origin. Check your network and GitHub access." ;;
esac

step "Installing the locked dependencies."
npm ci --ignore-scripts

# A fixed zip time rebuilds the same bytes, so a rerun still matches the hash on the registry.
step "Packaging $vsix."
SOURCE_DATE_EPOCH=$(git show --no-patch --format=%ct "$commit") node --run package

local_sha=$(shasum -a 256 "$vsix" | cut -d ' ' -f 1)
step "The package sha256 is $local_sha."

step "Proving the package in $editor_app."
node tests/editor/run.mjs "$vsix" "$editor_app" ||
	stop "the editor proof failed. Read the result above, then retry."

if $dry_run; then
	step "Dry run finished for $extension. Nothing was published, tagged or released."
	exit 0
fi

http_status() {
	curl --silent --show-error --location --max-time 30 --output /dev/null --write-out '%{http_code}' "$1"
}

publish() {
	step "Reading the Open VSX token from the Keychain item $token_item."
	OVSX_PAT=$(security find-generic-password -s "$token_item" -w) ||
		stop "add the Open VSX token to the Keychain item $token_item, then retry."
	export OVSX_PAT

	step "Checking the $publisher namespace on Open VSX."
	case $(http_status "$registry/api/$publisher") in
		200) ;;
		404)
			step "Creating the $publisher namespace."
			npx --no-install ovsx create-namespace "$publisher"
			;;
		*) stop "could not read the namespace from Open VSX. Check your network, then retry." ;;
	esac

	step "Publishing $extension to Open VSX."
	npx --no-install ovsx publish "$vsix" --skip-duplicate
	unset OVSX_PAT
}

step "Checking whether Open VSX has $extension."
case $(http_status "$version_url") in
	200) step "Skipping the upload because Open VSX already has $extension." ;;
	404) publish ;;
	*) stop "could not read $extension from Open VSX. Check your network, then retry." ;;
esac

published_sha() {
	local sha_url
	sha_url=$(curl --fail --silent --location --max-time 30 "$version_url" |
		node -e '
			let input = "";
			process.stdin.on("data", (chunk) => (input += chunk)).on("end", () => {
				process.stdout.write(JSON.parse(input).files.sha256);
			});
		') || return 1
	curl --fail --silent --location --max-time 30 "$sha_url"
}

step "Waiting for Open VSX to activate $extension."
attempt=1
until registry_sha=$(published_sha 2>/dev/null); do
	((attempt < retry_attempts)) ||
		stop "Open VSX has not activated $extension yet. Rerun bin/release-local later."
	step "Open VSX is not ready yet. Retrying in $retry_seconds seconds."
	sleep "$retry_seconds"
	attempt=$((attempt + 1))
done

step "Comparing the Open VSX sha256 with the local package."
[[ "$registry_sha" == "$local_sha" ]] ||
	stop "Open VSX serves $registry_sha for $extension, not $local_sha. Bump the version in package.json first."

if [[ -z "$local_tag" ]]; then
	step "Creating the annotated tag $tag."
	git tag --annotate "$tag" --message "$name $version"
fi

step "Pushing the tag $tag."
git push origin "refs/tags/$tag"

step "Reading the release notes for $version from CHANGELOG.md."
notes=$(awk -v version="$version" '
	/^## / {
		if (found) exit
		heading = $0
		sub(/^## +\[?v?/, "", heading)
		rest = substr(heading, length(version) + 1)
		if (index(heading, version) == 1 && rest !~ /^[0-9A-Za-z.-]/) {
			found = 1
			next
		}
	}
	found { print }
' CHANGELOG.md)
notes=$(printf '%s\n\nThe sha256 of %s is `%s`.' "$notes" "${vsix##*/}" "$local_sha")

if gh release view "$tag" >/dev/null 2>&1; then
	step "Attaching $vsix to the existing GitHub release $tag."
	gh release upload "$tag" "$vsix" --clobber
else
	step "Creating the GitHub release $tag."
	gh release create "$tag" "$vsix" --verify-tag --title "$tag" --notes "$notes"
fi

step "Released $extension with sha256 $local_sha."
