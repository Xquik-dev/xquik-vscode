{
  "printWidth": 80,
  "singleQuote": true,
  "proseWrap": "preserve",
  "objectWrap": "collapse",
  "sortPackageJson": false,
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"]
    ],
    "newlinesBetween": true
  }
}
